config {
  type: "table",
  name: "fct_flow_stats",
  description: "Statistiques finales agrégées par flux",
  assertions: {
    uniqueKey: ["flow_name"],
    rowConditions: [
      "total_lignes_traitees >= 0"
    ]
  }
}

SELECT
  flow_name,
  COUNT(*) as nb_executions,
  SUM(rows_count) as total_lignes_traitees
FROM ${ref("int_flux_logs_cleaned")}
GROUP BY 1